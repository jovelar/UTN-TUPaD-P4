@baseUrl = http://localhost:8000

### ============ PRODUCTOS PARA LOS PEDIDOS ============

### Crear producto 1
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Hamburguesa",
  "descripcion": "Hamburguesa simple",
  "precio_base": 5000,
  "imagenes_url": [],
  "disponible": true
}

### Crear producto 2
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Papas fritas",
  "descripcion": "Porción mediana",
  "precio_base": 2500,
  "imagenes_url": [],
  "disponible": true
}

### ============ PEDIDOS ============

### Crear pedido (201)
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 2 },
    { "producto_id": 2, "cantidad": 1 }
  ]
}

### Listar pedidos
GET {{baseUrl}}/pedidos/

### Obtener pedido con sus detalles
GET {{baseUrl}}/pedidos/1

### Actualizar estado
PUT {{baseUrl}}/pedidos/1
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}

### ERROR 422 - producto repetido
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 1, "cantidad": 3 }
  ]
}

### ERROR 422 - pedido sin detalles
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "detalles": []
}

### ERROR 422 - cantidad menor que 1
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 0 }
  ]
}

### ERROR 422 - estado fuera de los permitidos
PUT {{baseUrl}}/pedidos/1
Content-Type: application/json

{
  "estado": "ENVIADO"
}

### ERROR 404 - producto inexistente (no se guarda nada)
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "detalles": [
    { "producto_id": 1, "cantidad": 1 },
    { "producto_id": 999, "cantidad": 1 }
  ]
}

### ERROR 404 - pedido inexistente
GET {{baseUrl}}/pedidos/999

### ============ BORRADO LÓGICO ============

### Eliminar pedido (204)
DELETE {{baseUrl}}/pedidos/1

### ERROR 404 - el pedido eliminado ya no se puede consultar
GET {{baseUrl}}/pedidos/1

### El pedido eliminado ya no aparece en el listado
GET {{baseUrl}}/pedidos/