@baseUrl = http://localhost:8000

### ============ CATEGORÍAS ============

### Crear categoría 1
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Electrónica",
  "descripcion": "Dispositivos y accesorios electrónicos"
}

### Crear categoría 2
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Hogar",
  "descripcion": "Artículos para el hogar"
}

### Listar categorías
GET {{baseUrl}}/categorias/

### Obtener categoría por id
GET {{baseUrl}}/categorias/1

### Actualizar categoría
PUT {{baseUrl}}/categorias/1
Content-Type: application/json

{
  "nombre": "Electrónica y Tecnología",
  "descripcion": "Dispositivos, accesorios y tecnología"
}

### ERROR 404 - categoría inexistente
GET {{baseUrl}}/categorias/999

### ERROR 422 - body inválido (nombre vacío)
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "",
  "descripcion": "Sin nombre"
}

### ============ PRODUCTOS ============

### Crear producto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Notebook",
  "descripcion": "Notebook 15 pulgadas",
  "precio_base": 850000,
  "imagen_url": [
    "https://ejemplo.com/notebook-1.jpg",
    "https://ejemplo.com/notebook-2.jpg"
  ],
  "disponible": true
}

### Listar productos
GET {{baseUrl}}/productos/

### Obtener producto por id
GET {{baseUrl}}/productos/1

### Actualizar producto
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "nombre": "Notebook Pro",
  "descripcion": "Notebook 15 pulgadas, 16GB RAM",
  "precio_base": 950000,
  "imagen_url": ["https://ejemplo.com/notebook-pro.jpg"],
  "disponible": false
}

### ERROR 404 - producto inexistente
GET {{baseUrl}}/productos/999

### ERROR 422 - precio negativo
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Inválido",
  "descripcion": "Precio negativo",
  "precio_base": -10,
  "imagen_url": [],
  "disponible": true
}

### ============ PRODUCTO - CATEGORÍA ============

### Asignar categoría 1 al producto 1
POST {{baseUrl}}/productos/1/categorias/1

### Asignar categoría 2 al producto 1
POST {{baseUrl}}/productos/1/categorias/2

### Listar categorías del producto 1
GET {{baseUrl}}/productos/1/categorias

### ERROR 409 - asignar dos veces la misma
POST {{baseUrl}}/productos/1/categorias/1

### ERROR 404 - categoría inexistente
POST {{baseUrl}}/productos/1/categorias/999

### ERROR 404 - producto inexistente
POST {{baseUrl}}/productos/999/categorias/1

### Quitar categoría 2 del producto 1
DELETE {{baseUrl}}/productos/1/categorias/2

### ERROR 404 - quitar un vínculo que no existe
DELETE {{baseUrl}}/productos/1/categorias/2

### ============ ELIMINAR ============

### Eliminar producto
DELETE {{baseUrl}}/productos/1

### Eliminar categoría
DELETE {{baseUrl}}/categorias/2