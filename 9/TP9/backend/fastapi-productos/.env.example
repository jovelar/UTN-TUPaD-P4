# Copiar este archivo como .env y completar los valores.
# El archivo .env no se sube al repositorio ni se comparte (está en .gitignore).

# Base de datos (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=completar
POSTGRES_DB=TP-9
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT: clave de al menos 32 caracteres aleatorios.
# Para generarla: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=completar
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
